{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amba.local/schemas/dossier-v2.json",
  "title": "AMBA Dossier v2",
  "description": "Result object returned by every audit route. Mirrors api/openapi.yaml.",
  "type": "object",
  "$defs": {
    "Status": {
      "type": "string",
      "enum": [
        "SAFE",
        "SUSPICIOUS",
        "TAMPERED",
        "INSUFFICIENT"
      ]
    },
    "FactStatus": {
      "type": "string",
      "enum": [
        "CONTRADICTS",
        "SUPPORTS",
        "UNVERIFIED"
      ]
    },
    "InputType": {
      "type": "string",
      "enum": [
        "URL",
        "FILE"
      ]
    },
    "Anomaly": {
      "type": "object",
      "properties": {
        "bounding_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "description": "Normalized [ymin, xmin, ymax, xmax] on a 0-1000 scale"
        },
        "extracted_text": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Timpa Teks: how differently the text in the box reacts to JPEG re-compression compared with the image's other text (0-100); null when it could not be measured."
        }
      },
      "required": [
        "bounding_box"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/FactStatus"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "match"
      ]
    },
    "LinkReason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ]
    },
    "Tactic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "URGENCY",
            "REWARD_BAIT",
            "FALSE_AUTHORITY",
            "FEAR",
            "SECRECY",
            "OUTRAGE_BAIT",
            "IMPERSONATION",
            "FAKE_SOCIAL_PROOF"
          ]
        },
        "phrase": {
          "type": "string",
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "enum": [
            "text",
            "ocr"
          ]
        }
      },
      "required": [
        "code",
        "phrase",
        "source"
      ]
    },
    "Verdict": {
      "type": "object",
      "properties": {
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "RISK score, not confidence. Always present on new results (null only in old INSUFFICIENT payloads)."
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "short_title": {
          "type": "string"
        },
        "explanation": {
          "type": "string",
          "maxLength": 400
        },
        "explanation_simple": {
          "type": "string",
          "maxLength": 140
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ela",
              "ai",
              "fact",
              "link",
              "llm_untrusted"
            ]
          }
        },
        "not_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ela",
              "ai",
              "fact",
              "link"
            ]
          }
        },
        "floors_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "FACT_CONTRADICTED",
              "LINK_MALICIOUS",
              "LINK_STRONG",
              "ELA_CORROBORATED",
              "ELA_SOLO_CAP",
              "INJECTION_GUARD",
              "AI_PROVENANCE",
              "AI_EDITED",
              "AI_LIKELY",
              "VIDEO_CONTEXT_MISMATCH",
              "VIDEO_MANIPULATED"
            ]
          }
        }
      },
      "required": [
        "status",
        "explanation",
        "explanation_simple",
        "basis",
        "not_checked",
        "floors_applied"
      ]
    },
    "Pillars": {
      "type": "object",
      "properties": {
        "ela": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "score": {
              "type": "integer"
            },
            "reliability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reliability_note": {
              "type": [
                "string",
                "null"
              ]
            },
            "anomalies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Anomaly"
              }
            }
          },
          "required": [
            "available",
            "score",
            "reliability"
          ]
        },
        "ai": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "reliability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "indicators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "caveat": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/Provenance"
            },
            "detector": {
              "oneOf": [
                {
                  "$ref": "#/$defs/AIDetector"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "available",
            "score"
          ],
          "description": "Jejak AI: whether the image (the upload, or a link's preview image) was made with AI. score is a likelihood computed in Go from the image's provenance, an optional detector and the model's visible clues."
        },
        "fact": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "claim": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/FactStatus"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Source"
              }
            }
          },
          "required": [
            "available",
            "status"
          ]
        },
        "link": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "score": {
              "type": "integer"
            },
            "final_url": {
              "type": "string"
            },
            "redirect_chain": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LinkReason"
              }
            }
          },
          "required": [
            "available",
            "score"
          ]
        }
      }
    },
    "Provenance": {
      "type": "object",
      "description": "What the image declares about its origin: Content Credentials (c2pa), IPTC/XMP metadata (xmp), generator settings in PNG text (png_text), EXIF (exif), or an AI label visible on the image (watermark). Missing metadata proves nothing; camera data is a hint, not proof.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "AI_GENERATED",
            "AI_EDITED",
            "CAMERA",
            "NONE"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "c2pa",
            "xmp",
            "png_text",
            "exif",
            "watermark",
            "creator",
            "web",
            ""
          ]
        },
        "generator": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "c2pa": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "source",
        "generator",
        "camera",
        "c2pa"
      ]
    },
    "AIDetector": {
      "type": "object",
      "description": "A dedicated AI-image detector's answer, present only when one is configured and answered.",
      "properties": {
        "name": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "name",
        "score"
      ]
    },
    "Dossier": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "id": {
          "type": "string",
          "example": "AMBA-20261030-7F3K"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "input_type": {
          "$ref": "#/$defs/InputType"
        },
        "source_reference": {
          "type": "string",
          "maxLength": 200
        },
        "degraded": {
          "type": "boolean"
        },
        "is_demo": {
          "type": "boolean"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "pillars": {
          "$ref": "#/$defs/Pillars"
        },
        "tactics": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/Tactic"
          }
        },
        "share_token": {
          "type": "string"
        },
        "source_metadata": {
          "description": "Public description of the submitted link (PRD F1). null for FILE input.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/SourceMetadata"
            }
          ]
        },
        "ocr_text": {
          "type": "string",
          "maxLength": 2000,
          "description": "Text the model read in an uploaded image (FILE only, empty otherwise)."
        },
        "video": {
          "description": "Frame-by-frame analysis of a social video link (TikTok, YouTube, X, Instagram, Facebook). Absent for other input.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/VideoAnalysis"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "timestamp",
        "input_type",
        "source_reference",
        "degraded",
        "is_demo",
        "verdict",
        "pillars",
        "tactics",
        "share_token"
      ]
    },
    "VideoAnalysis": {
      "type": "object",
      "description": "A social video downloaded from the submitted link and analysed frame by frame, and by its soundtrack when the model takes audio. The AI score lives in pillars.ai.",
      "properties": {
        "status": { "type": "string", "enum": ["OK", "UNAVAILABLE"] },
        "reason": { "type": "string", "enum": ["", "unsupported", "private", "too_long", "too_big", "timeout", "download_failed", "no_tools", "model_failed"] },
        "platform": { "type": "string", "enum": ["youtube", "tiktok", "x", "instagram", "facebook"] },
        "duration_sec": { "type": "number", "minimum": 0 },
        "upload_date": { "type": "string", "description": "YYYY-MM-DD, or empty when unknown." },
        "platform_ai_label": { "type": "boolean" },
        "frames": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/VideoFrame" } },
        "audio_analyzed": { "type": "boolean" },
        "summary": { "type": "string", "maxLength": 300 },
        "transcript": { "type": "string", "maxLength": 800 },
        "manipulation": { "$ref": "#/$defs/VideoSignal" },
        "context": { "$ref": "#/$defs/VideoSignal" },
        "creator_disclosure": { "$ref": "#/$defs/CreatorDisclosure" },
        "web_evidence": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/WebEvidence" } },
        "w5h1": { "$ref": "#/$defs/W5H1" },
        "research": { "$ref": "#/$defs/Research" }
      },
      "required": ["status", "reason", "platform", "duration_sec", "upload_date", "platform_ai_label", "frames", "audio_analyzed", "summary", "transcript", "manipulation", "context"]
    },
    "W5H1": {
      "type": "object",
      "description": "What the video shows, one short answer per question; empty where the video does not show it. Absent when the model gave none.",
      "properties": {
        "what": { "type": "string", "maxLength": 160 },
        "who": { "type": "string", "maxLength": 160 },
        "when": { "type": "string", "maxLength": 160 },
        "where": { "type": "string", "maxLength": 160 },
        "why": { "type": "string", "maxLength": 160 },
        "how": { "type": "string", "maxLength": 160 }
      },
      "required": ["what", "who", "when", "where", "why", "how"]
    },
    "Research": {
      "type": "object",
      "description": "One web search on trusted newsrooms and fact-checkers for what the video shows: the trail behind the verdict. No model judges these pages. Absent when no search ran.",
      "properties": {
        "query": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["FOUND", "NONE", "UNAVAILABLE"] },
        "sources": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/ResearchSource" } }
      },
      "required": ["query", "status", "sources"]
    },
    "ResearchSource": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "pattern": "^https://" },
        "domain": { "type": "string", "maxLength": 80 },
        "snippet": { "type": "string", "maxLength": 280 },
        "published": { "type": "string", "description": "Empty when the search did not say." }
      },
      "required": ["title", "url", "domain", "snippet", "published"]
    },
    "CreatorDisclosure": {
      "type": "object",
      "description": "What the creator says about AI in the post. strong: names AI or a generator as the maker. weak: only mentions AI. none: nothing, or news about AI.",
      "properties": {
        "level": { "type": "string", "enum": ["none", "weak", "strong"] },
        "phrase": { "type": "string", "maxLength": 60 }
      },
      "required": ["level", "phrase"]
    },
    "WebEvidence": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "pattern": "^https://" },
        "publisher": { "type": "string", "maxLength": 80 },
        "says": { "type": "string", "enum": ["AI", "REAL", "HOAX"] }
      },
      "required": ["title", "url", "publisher", "says"]
    },
    "VideoFrame": {
      "type": "object",
      "properties": {
        "at_sec": { "type": "number", "minimum": 0 },
        "thumb": { "type": "string", "pattern": "^data:image/jpeg;base64,", "description": "JPEG thumbnail, longest side <= 240 px." }
      },
      "required": ["at_sec", "thumb"]
    },
    "VideoSignal": {
      "type": "object",
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "indicators": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 160 } }
      },
      "required": ["score", "indicators"]
    },
    "SourceMetadata": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "BLOCKED",
            "UNAVAILABLE"
          ]
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube",
            "tiktok",
            "x",
            "instagram",
            "facebook",
            "threads",
            "web"
          ]
        },
        "via": {
          "type": "string",
          "enum": [
            "oembed",
            "opengraph",
            ""
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "site_name": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "status",
        "platform",
        "via",
        "title",
        "author",
        "description",
        "site_name"
      ]
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_URL",
                "BLOCKED_TARGET",
                "UNSUPPORTED_MEDIA",
                "PAYLOAD_TOO_LARGE",
                "RATE_LIMITED",
                "UPSTREAM_TIMEOUT",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "id": {
      "type": "string",
      "example": "AMBA-20261030-7F3K"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "input_type": {
      "$ref": "#/$defs/InputType"
    },
    "source_reference": {
      "type": "string",
      "maxLength": 200
    },
    "degraded": {
      "type": "boolean"
    },
    "is_demo": {
      "type": "boolean"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "pillars": {
      "$ref": "#/$defs/Pillars"
    },
    "tactics": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/Tactic"
      }
    },
    "share_token": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "timestamp",
    "input_type",
    "source_reference",
    "degraded",
    "is_demo",
    "verdict",
    "pillars",
    "tactics",
    "share_token"
  ]
}
