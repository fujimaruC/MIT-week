{
  "name": "amba-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node tools/preload-fonts.mjs",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node tools/check-size.mjs",
    "contrast": "node tools/check-contrast.mjs",
    "headers": "node tools/check-host-headers.mjs",
    "lighthouse": "node tools/lighthouse.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^24.19.2",
    "autoprefixer": "10.6.2",
    "chrome-launcher": "^1.2.3",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "jsdom": "30.1.3",
    "lighthouse": "^13.6.0",
    "postcss": "8.5.32",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@lucide/svelte": "^1.66.0",
    "zod": "4.6.7"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
